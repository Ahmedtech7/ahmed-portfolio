---
import '../styles/global.css';
import { Picture, getImage } from 'astro:assets';
import displayUrl from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import AhmedOS from '../components/AhmedOS.astro';
import ProjectCard from '../components/ProjectCard.astro';
import {
  person, sections, focus, logos, education, experience, projects, skillGroups, hackathons, programs, certificates,
} from '../data';

const title = 'Ahmed Alhejaili — AI Engineer';
const description =
  'AI Engineer and Computer Science graduate (GPA 4.78/5, First Class Honors) building RAG systems, AI agents and machine learning applications. Five live projects.';
const canonical = new URL('/', Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;

const fullCerts = await Promise.all(
  certificates.map((c) => getImage({ src: c.image, width: 1600, format: 'webp', quality: 82 })),
);
const num = (i: number) => String(i + 1).padStart(2, '0');
const newTab = { target: '_blank', rel: 'noopener noreferrer' };
const [olo, sani] = programs;

// Where a linked skill points, in words, so the chip can say what proves it.
const proofOf = (href: string) => {
  if (href.startsWith('#project-')) return projects.find((p) => `#project-${p.id}` === href)?.title ?? 'Project';
  return { '#projects': 'All projects', '#programs': 'Programs', '#certifications': 'Certificates' }[href] ?? 'GitHub';
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  jobTitle: 'AI Engineer',
  email: `mailto:${person.email}`,
  url: canonical,
  sameAs: [person.linkedin, person.github],
  alumniOf: { '@type': 'CollegeOrUniversity', name: education.school },
  knowsAbout: focus,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={displayUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f3f3ef" />
    <meta name="format-detection" content="telephone=no" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ahmed Alhejaili — AI Engineer | Computer Science Graduate" />
    <meta property="profile:first_name" content="Ahmed" />
    <meta property="profile:last_name" content="Alhejaili" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav-bar">
      <div class="wrap">
        <a class="brand" href="#home"><i aria-hidden="true">AA</i><span>Ahmed Alhejaili</span><span class="sr-only">Ahmed Alhejaili, back to top</span></a>
        <nav class="links" aria-label="Sections">
          {sections.map(([id, label]) => <a href={`#${id}`} data-nav={id}>{label}</a>)}
        </nav>
        <div class="nav-end">
          <a class="icon-link" href={person.github} {...newTab}><Icon name="github" size={18} /><span class="sr-only">GitHub (opens in a new tab)</span></a>
          <a class="icon-link" href={person.linkedin} {...newTab}><Icon name="linkedin" size={18} /><span class="sr-only">LinkedIn (opens in a new tab)</span></a>
          <a class="cta" href="#contact">Get in touch</a>
          <details class="menu">
            <summary>Menu <span aria-hidden="true">↓</span></summary>
            <nav aria-label="Sections">
              {sections.map(([id, label], i) => <a href={`#${id}`}><span>{num(i)}</span>{label}</a>)}
            </nav>
          </details>
        </div>
      </div>
      <span class="progress" aria-hidden="true"></span>
    </header>

    <main id="main">
      <!-- 01 Home -->
      <section id="home" class="hero" aria-labelledby="home-title">
        <div class="aura" aria-hidden="true"></div>
        <div class="wrap">
          <p class="kicker mono fade"><b>01 — Home</b><span>AI Engineer | Computer Science Graduate</span></p>
          <h1 id="home-title" class="name"><span class="rise">Ahmed</span><span class="line2 rise d2">Alhejaili</span></h1>
          <p class="headline fade">Builder of <em>real</em> intelligent systems.</p>
          <p class="support fade">I design RAG pipelines, AI agents and machine-learning models, then ship them as live software you can open today.</p>
          <div class="ctas fade late">
            <a class="btn primary" href="#projects">View projects <span class="arrow" aria-hidden="true">↘</span></a>
            <a class="btn" href={person.twin} {...newTab}>Talk to my Digital Twin <span class="arrow" aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
            <a class="btn" href={person.github} {...newTab}><Icon name="github" /> GitHub<span class="sr-only"> (opens in a new tab)</span></a>
            <a class="btn" href={person.linkedin} {...newTab}><Icon name="linkedin" /> LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
          </div>
          <ul class="highlights fade late" aria-label="Highlights">
            <li><a href="#education"><span class="fig">{education.gpa}<small> / {education.gpaOf} GPA</small></span><span class="what"><b>{education.honors}</b>B.Sc. Computer Science, {education.school}</span></a></li>
            <li><a href="#experience"><span class="fig">−50%</span><span class="what"><b>Credit-review time</b>AI solution built during SIDF co-op training, 2025</span></a></li>
            <li><a href="#programs"><span class="fig hot">{olo!.rank}</span><span class="what"><b>{olo!.among}</b>{olo!.name}, {olo!.org}</span></a></li>
            <li><a href="#programs"><span class="fig hot">{sani!.rank}</span><span class="what"><b>{sani!.among}</b>SANI | صانع — {sani!.name}</span></a></li>
          </ul>
        </div>
      </section>

      <AhmedOS />

      <!-- 02 Education -->
      <section id="education" aria-labelledby="education-title">
        <div class="wrap">
          <header class="sec-head"><span class="num">02</span><h2 id="education-title">Education</h2></header>
          <div class="edu reveal">
            <div class="seal"><Logo logo={logos.iu} height={120} /></div>
            <div class="edu-body">
              <h3>{education.degree}</h3>
              <p class="school">{education.school}</p>
              <p class="period mono">{education.period}</p>
              <dl class="stats">
                <div class="stat"><dt class="mono">GPA</dt><dd>{education.gpa}<small> / {education.gpaOf}</small></dd></div>
                <div class="stat"><dt class="mono">Honors</dt><dd class="honors">{education.honors}</dd></div>
              </dl>
            </div>
          </div>
        </div>
      </section>

      <!-- 03 Experience -->
      <section id="experience" aria-labelledby="experience-title">
        <div class="wrap">
          <header class="sec-head"><span class="num">03</span><h2 id="experience-title">Experience</h2></header>
          <article class="exp reveal">
            <div>
              <div class="exp-head">
                <Logo logo={logos.sidf} height={108} />
                <div>
                  <h3>{experience.org} <span>({experience.orgShort})</span></h3>
                  <p class="ar" lang="ar" dir="rtl">{experience.orgAr}</p>
                </div>
              </div>
              <p class="exp-meta"><span class="role">{experience.role}</span><span class="mono muted">{experience.period}</span><span class="badge">{experience.type}</span></p>
            </div>
            <p class="impact"><strong>−50%</strong><span>credit-review time, within the project’s scope</span></p>
            <ol class="points">
              {experience.highlights.filter((h) => !h.includes('50%')).map((h) => <li>{h}</li>)}
            </ol>
          </article>
        </div>
      </section>

      <!-- 04 Projects -->
      <section id="projects" class="projects-intro" aria-labelledby="projects-title">
        <div class="wrap">
          <header class="sec-head"><span class="num">04</span><h2 id="projects-title">Projects</h2><span class="deck">{projects.length} AI applications, live on Vercel. Click any screenshot to open the real app.</span></header>
        </div>
      </section>
      {projects.map((p, i) => <ProjectCard p={p} i={i} total={projects.length} />)}

      <!-- 05 Skills -->
      <section id="skills" aria-labelledby="skills-title">
        <div class="wrap">
          <header class="sec-head"><span class="num">05</span><h2 id="skills-title">Skills</h2></header>
          <div class="skills">
            {skillGroups.map((g, i) => (
              <div class="skill-row reveal">
                <h3><span>{`05.${i + 1}`}</span>{g.name}</h3>
                <ul class="tags">
                  {g.skills.map((s) => (
                    <li>
                      {s.href ? (
                        <a class="tag" href={s.href} {...(s.href.startsWith('http') ? newTab : {})}>
                          {s.icon && <Icon name={s.icon} size={15} />}{s.name}<span class="to"><span aria-hidden="true">&nbsp;→&nbsp;</span>{proofOf(s.href)}</span>
                        </a>
                      ) : (
                        <span class="tag">{s.icon && <Icon name={s.icon} size={15} />}{s.name}</span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          <p class="skill-note"><b>Blue-outlined skills</b> link to the project, program or certificate that demonstrates them. Hover to see which.</p>
        </div>
      </section>

      <!-- 06 Hackathons -->
      <section id="hackathons" aria-labelledby="hackathons-title">
        <div class="wrap">
          <header class="sec-head"><span class="num">06</span><h2 id="hackathons-title">Hackathons</h2><span class="deck mono">Competing, building, mentoring</span></header>
          <ol class="ledger">
            {hackathons.map((h) => (
              <li class="reveal">
                <span class="date">{h.date}</span>
                <span class="plate">{h.logos.map((l) => <Logo logo={l} height={l.kind === 'tile' ? 37 : 29} />)}</span>
                <div>
                  <h3>{h.event}{h.project && <> · <em>{h.project}</em></>}</h3>
                  <p class="host">{h.host}</p>
                </div>
                <div>
                  <span class="badge">{h.role}</span>
                  <p class="line">{h.line}</p>
                  {h.note && <p class="note">{h.note}</p>}
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- 07 Programs -->
      <section id="programs" class="programs-sec" aria-labelledby="programs-title">
        <div class="wrap">
          <header class="sec-head"><span class="num">07</span><h2 id="programs-title">Programs</h2><span class="deck mono">Selected from thousands of applicants</span></header>
          <div class="programs">
            {programs.map((p) => (
              <article class="program reveal">
                <div class="top">
                  <span class="logos">{p.logos.map((l) => <Logo logo={l} height={l.kind === 'tile' ? 56 : 40} />)}</span>
                  <span class={p.status === 'Ongoing' ? 'badge' : 'badge ok'}>{p.status}</span>
                </div>
                <p class="rank"><strong>{p.rank}</strong><span>— {p.among}</span></p>
                <div>
                  <h3>{p.name}</h3>
                  <p class="org">{p.org}</p>
                </div>
                <p class="desc">{p.line}</p>
                <ul class="tags" aria-label="Topics">{p.topics.map((t) => <li class="tag">{t}</li>)}</ul>
                <div class="foot mono">
                  <span>{p.period}</span>
                  {p.link && <a href={p.link} {...newTab}>SANI on LinkedIn ↗<span class="sr-only"> (opens in a new tab)</span></a>}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- 08 Certifications -->
      <section id="certifications" aria-labelledby="certifications-title">
        <div class="wrap">
          <header class="sec-head"><span class="num">08</span><h2 id="certifications-title">Certifications</h2><span class="deck mono">Original certificates · click to enlarge</span></header>
          <ul class="certs">
            {certificates.map((c, i) => (
              <li class="cert reveal">
                <button type="button" class="mat" data-full={fullCerts[i]!.src} data-title={c.title} data-pdf={c.pdf} data-verify={c.verify ?? ''} aria-label={`Enlarge certificate: ${c.title}`}>
                  <Picture src={c.image} alt="" formats={['avif']} fallbackFormat="webp" widths={[640, 960, 1280]} sizes="(min-width: 1600px) 44rem, (min-width: 760px) 46vw, 100vw" quality={72} loading="lazy" decoding="async" />
                </button>
                <div class="label">
                  <span class="no">No. {num(i)}</span>
                  <h3>{c.title}</h3>
                  <p class="meta">{c.issuer} · {c.date}</p>
                  <p class="cert-links">
                    <a href={c.pdf} {...newTab}>View PDF<span class="sr-only"> of {c.title} (opens in a new tab)</span></a>
                    {c.verify ? (
                      <a href={c.verify} {...newTab}>Verify credential ↗<span class="sr-only"> {c.title} on Coursera (opens in a new tab)</span></a>
                    ) : (
                      <span>Certificate code {c.code}</span>
                    )}
                  </p>
                </div>
              </li>
            ))}
          </ul>
        </div>
        <dialog class="viewer" id="viewer" aria-labelledby="viewer-title">
          <header>
            <p id="viewer-title"></p>
            <div class="acts">
              <a id="viewer-pdf" href="#" {...newTab}>View original PDF</a>
              <a id="viewer-verify" href="#" {...newTab}>Verify credential ↗</a>
              <form method="dialog"><button type="submit" aria-label="Close certificate viewer">Close ✕</button></form>
            </div>
          </header>
          <img id="viewer-img" alt="" />
        </dialog>
      </section>

      <!-- 09 Contact -->
      <section id="contact" class="contact" aria-labelledby="contact-title">
        <div class="wrap contact-grid">
          <div>
            <p class="mono">09 — Contact</p>
            <h2 id="contact-title">Let’s build something <em>intelligent</em>.</h2>
            <p class="lead">Email or LinkedIn is the fastest way to reach me.</p>
          </div>
          <div class="cards">
            <a class="primary" href={`mailto:${person.email}`}>
              <span class="lbl mono"><span>Email</span><span aria-hidden="true">↗</span></span>
              <span class="value">{person.email}</span>
            </a>
            <a class="primary" href={person.linkedin} {...newTab}>
              <span class="lbl mono"><span>LinkedIn</span><Icon name="linkedin" size={18} /></span>
              <span class="value">in/ahmed-alhejaili1<span class="sr-only"> (opens in a new tab)</span></span>
            </a>
            <a href={person.phoneHref}>
              <span class="lbl mono"><span>Phone</span><span aria-hidden="true">↗</span></span>
              <span class="value">{person.phoneDisplay}</span>
            </a>
            <a href={person.github} {...newTab}>
              <span class="lbl mono"><span>GitHub</span><Icon name="github" size={18} /></span>
              <span class="value">github.com/Ahmedtech7<span class="sr-only"> (opens in a new tab)</span></span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site">
      <div class="wrap">
        <span>© 2026 {person.name}</span>
        <a href="#home">Back to top ↑</a>
      </div>
    </footer>

    <script>
      // Certificate viewer: native <dialog> handles focus trapping, Esc and focus return. Full images load only on open.
      const viewer = document.getElementById('viewer') as HTMLDialogElement;
      const img = document.getElementById('viewer-img') as HTMLImageElement;
      const caption = document.getElementById('viewer-title')!;
      const pdf = document.getElementById('viewer-pdf') as HTMLAnchorElement;
      const verify = document.getElementById('viewer-verify') as HTMLAnchorElement;
      document.querySelectorAll<HTMLButtonElement>('[data-full]').forEach((btn) =>
        btn.addEventListener('click', () => {
          const d = btn.dataset;
          img.src = d.full!;
          img.alt = `Certificate: ${d.title}`;
          caption.textContent = d.title ?? '';
          pdf.href = d.pdf!;
          verify.hidden = !d.verify;
          if (d.verify) verify.href = d.verify;
          viewer.showModal();
        }),
      );
      viewer.addEventListener('click', (e) => { if (e.target === viewer) viewer.close(); });

      // Underline the current section in the top bar.
      const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')].map((a) => [a.dataset.nav, a]));
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (!e.isIntersecting || !links.has(e.target.id)) return;
          links.forEach((a) => a.removeAttribute('aria-current'));
          links.get(e.target.id)!.setAttribute('aria-current', 'true');
        }),
        { rootMargin: '-45% 0px -50% 0px' },
      );
      document.querySelectorAll('main > section').forEach((s) => io.observe(s));

      // Close the small-screen menu after choosing a section.
      const menu = document.querySelector('.menu')!;
      menu.querySelectorAll('nav a').forEach((a) => a.addEventListener('click', () => menu.removeAttribute('open')));
    </script>
  </body>
</html>
