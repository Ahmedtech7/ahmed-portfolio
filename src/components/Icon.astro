---
import { icons } from '../icons';

interface Props { name: string; size?: number; class?: string }
const { name, size = 16, class: className } = Astro.props;
const path = icons[name];
---
{path && (
  <svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d={path} /></svg>
)}
